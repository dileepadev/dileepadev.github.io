---
import "../styles/components/theme-toggle.css";
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Switch colour theme"
>
  <svg
    class="moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg
    class="sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="M4.93 4.93l1.41 1.41"></path>
    <path d="M17.66 17.66l1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="M4.93 19.07l1.41-1.41"></path>
    <path d="M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script>
  // One storage key across every platform surface - design-system.md §11 -
  // so the theme follows a visitor from the main site to links and back.
  const STORAGE_KEY = "dileepa-theme";
  const button = document.getElementById("theme-toggle");

  // The radial spotlight transition, ported from dileepa-dev's
  // ThemeToggle.tsx: an aperture circle of the target theme expands from
  // the toggle's own centre across the viewport via the View Transitions
  // API. Falls back to an instant swap with no delay when the browser
  // doesn't support it or the visitor prefers reduced motion - same as
  // the reference.
  const REVEAL_MS = 2000;
  const REVEAL_EASING = [0.16, 1, 0.3, 1] as const;

  function timeAtProgress(progress: number): number {
    const [x1, y1, x2, y2] = REVEAL_EASING;
    const bezier = (s: number, a: number, b: number) =>
      3 * (1 - s) ** 2 * s * a + 3 * (1 - s) * s ** 2 * b + s ** 3;
    let low = 0;
    let high = 1;
    for (let i = 0; i < 20; i += 1) {
      const mid = (low + high) / 2;
      if (bezier(mid, y1, y2) < progress) low = mid;
      else high = mid;
    }
    return bezier((low + high) / 2, x1, x2);
  }

  function applyTheme(next: string) {
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem(STORAGE_KEY, next);
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";

    const supportsViewTransitions =
      typeof document !== "undefined" && "startViewTransition" in document;
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!supportsViewTransitions || reducedMotion) {
      applyTheme(next);
      return;
    }

    const rect = button?.getBoundingClientRect();
    const x = rect ? rect.left + rect.width / 2 : window.innerWidth / 2;
    const y = rect ? rect.top + rect.height / 2 : 0;

    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y),
    );

    // Hold the window scrollbar's current colours until the reveal circle
    // reaches it, matching dileepa-dev's ThemeToggle.tsx.
    const root = document.documentElement;
    const before = getComputedStyle(root);
    root.style.setProperty("scrollbar-color", before.scrollbarColor);
    root.style.setProperty("color-scheme", before.colorScheme);
    const releaseScrollbar = () => {
      root.style.removeProperty("scrollbar-color");
      root.style.removeProperty("color-scheme");
    };
    const scrollbarReach = Math.hypot(
      window.innerWidth - x,
      window.innerHeight / 2 - y,
    );

    const transition = (
      document as unknown as {
        startViewTransition: (callback: () => void) => {
          ready: Promise<void>;
          finished: Promise<void>;
        };
      }
    ).startViewTransition(() => applyTheme(next));

    transition.ready.then(() => {
      document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: REVEAL_MS,
          easing: `cubic-bezier(${REVEAL_EASING.join(", ")})`,
          pseudoElement: "::view-transition-new(root)",
        } as KeyframeAnimationOptions,
      );
      window.setTimeout(
        releaseScrollbar,
        timeAtProgress(Math.min(1, scrollbarReach / endRadius)) * REVEAL_MS,
      );
    });
    transition.finished.finally(releaseScrollbar);
  }

  button?.addEventListener("click", toggleTheme);

  const media = window.matchMedia("(prefers-color-scheme: dark)");
  media.addEventListener("change", (e) => {
    if (localStorage.getItem(STORAGE_KEY)) return;
    document.documentElement.setAttribute(
      "data-theme",
      e.matches ? "dark" : "light",
    );
  });
</script>

---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import pkg from "../../package.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dileepa Bandara | Build log",
  description = "A public build log — what is being built across the dileepadev GitHub account, and whether it is moving.",
} = Astro.props;

const site = Astro.site ?? new URL("https://dileepadev.github.io");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;

const NAV = [
  { href: "/", label: "Overview" },
  { href: "/repos/", label: "Repos" },
  { href: "/activity/", label: "Activity" },
  { href: "/ci/", label: "CI" },
  { href: "/deployments/", label: "Deployments" },
];

// The rest of the platform. dileepa-dev's navbar keeps an Explore dropdown for
// the pages that do not fit on the bar; this site has only five pages, so the
// same control carries the other surfaces instead — the build log is the one
// place with no other route out to them.
const EXPLORE = [
  { href: "https://dileepa.dev", label: "Main site" },
  { href: "https://dileepa.dev/blog", label: "Blog" },
  { href: "https://links.dileepa.dev", label: "Links" },
  { href: "https://github.com/dileepadev", label: "GitHub" },
];

// Astro serves `/repos/` and `/repos` as the same page; normalise before
// comparing so the current item is marked either way.
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  (href.replace(/\/+$/, "") || "/") === current;

const repoUrl = pkg.repository.url.replace(/\.git$/, "");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: title,
  url: site.href,
  description,
  inLanguage: "en",
  publisher: {
    "@type": "Person",
    name: "Dileepa Bandara",
    alternateName: "dileepadev",
    url: "https://dileepa.dev",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- The token sheet's own font @import doesn't survive being vendored
         under `@layer` — `@import` is invalid there per spec, and the CSS
         optimiser drops it with a warning. Loaded here instead, same URL,
         same fonts, same weights. Mono is the majority face on this
         surface, so it carries weight 500 as well as 400. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />

    <meta property="og:site_name" content="dileepadev.github.io" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dileepadev" />
    <meta name="twitter:creator" content="@dileepadev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={description} />

    <meta name="robots" content="index, follow" />

    <!-- The favicon is the portrait, at every size — brand-guide.md §3.2 —
         matching dileepa-dev and links-dileepa-dev. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png" />
    <link
      rel="apple-touch-icon"
      href="/apple-icon-180x180.png"
      sizes="180x180"
    />
    <link rel="manifest" href="/manifest.json" />

    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      content="#050505"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#f7f7f7"
      media="(prefers-color-scheme: light)"
    />

    <title>{title}</title>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Applies the persisted theme before first paint, so there is no flash
         of the wrong theme. One storage key across the platform —
         design-system.md §11 — "dileepa-theme". -->
    <script is:inline>
      (function () {
        try {
          var KEY = "dileepa-theme";
          var stored = localStorage.getItem(KEY);
          var theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (err) {
          // Leave the token sheet's default (dark) in place.
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="nav-wrapper" id="nav-wrapper">
          <div class="nav">
            <a href="/" class="lockup" aria-label="dileepadev, home">
              <span class="wordmark">dileepadev</span><span
                class="mark"
                aria-hidden="true">/</span
              >
            </a>

            <div class="nav-right">
              <nav class="nav-links" aria-label="Pages">
                {
                  NAV.map((item) => (
                    <a
                      href={item.href}
                      class:list={[
                        "nav-link",
                        isCurrent(item.href) && "is-active",
                      ]}
                      aria-current={isCurrent(item.href) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  ))
                }

                <div class="nav-explore">
                  <button
                    id="explore-toggle"
                    type="button"
                    class="nav-link nav-explore-trigger"
                    aria-expanded="false"
                    aria-haspopup="menu"
                    aria-controls="explore-menu"
                  >
                    <span>Explore</span>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </button>

                  <div
                    id="explore-menu"
                    class="nav-menu"
                    role="menu"
                    aria-label="Explore"
                    hidden
                  >
                    {
                      EXPLORE.map((item) => (
                        <a
                          href={item.href}
                          class="nav-menu-item"
                          role="menuitem"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <span>{item.label}</span>
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                          </svg>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </nav>

              <div class="nav-controls">
                <ThemeToggle />

                <button
                  id="nav-toggle"
                  type="button"
                  class="nav-mobile-toggle"
                  aria-label="Open navigation menu"
                  aria-expanded="false"
                  aria-controls="nav-menu"
                >
                  <svg
                    class="icon-open"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                  </svg>
                  <svg
                    class="icon-close"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div id="nav-menu" class="nav-mobile-menu" hidden>
            <nav aria-label="Mobile navigation">
              <div class="nav-mobile-section-label">Pages</div>
              <div class="nav-mobile-links">
                {
                  NAV.map((item) => (
                    <a
                      href={item.href}
                      class:list={[
                        "nav-mobile-link",
                        isCurrent(item.href) && "is-active",
                      ]}
                      aria-current={isCurrent(item.href) ? "page" : undefined}
                    >
                      <span>{item.label}</span>
                      {isCurrent(item.href) && (
                        <span class="nav-active-dot" aria-hidden="true" />
                      )}
                    </a>
                  ))
                }
              </div>

              <div class="nav-mobile-divider"></div>

              <div class="nav-mobile-section-label">Explore</div>
              <div class="nav-mobile-grid">
                {
                  EXPLORE.map((item) => (
                    <a
                      href={item.href}
                      class="nav-mobile-sublink"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span>{item.label}</span>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M7 17 17 7" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </a>
                  ))
                }
              </div>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>&copy; {new Date().getFullYear()} Dileepa Bandara</p>
        <div class="footer-meta">
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View source on GitHub"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.97.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
              ></path>
            </svg>
            <span>Source</span>
          </a>
          <span class="footer-sep" aria-hidden="true">/</span>
          <a
            href="https://dileepa.dev"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>dileepa.dev</span>
          </a>
          <span class="footer-sep" aria-hidden="true">/</span>
          <span>v{pkg.version}</span>
        </div>
        <p class="mono" style="font-size: var(--text-label)">
          Data from the public GitHub API, fetched at build time.
        </p>
      </div>
    </footer>

    <script>
      // Both dropdowns, behaving the way dileepa-dev's navbar does: they close
      // on an outside pointer press and on Escape, and the mobile menu resets
      // when the viewport crosses back above the breakpoint where the inline
      // links take over.
      const wrapper = document.getElementById("nav-wrapper");
      const navToggle = document.getElementById("nav-toggle");
      const navMenu = document.getElementById("nav-menu");
      const exploreToggle = document.getElementById("explore-toggle");
      const exploreMenu = document.getElementById("explore-menu");

      function setMobile(open: boolean) {
        if (!navToggle || !navMenu) return;
        navToggle.setAttribute("aria-expanded", String(open));
        navToggle.setAttribute(
          "aria-label",
          open ? "Close navigation menu" : "Open navigation menu",
        );
        navToggle.classList.toggle("is-open", open);
        navMenu.hidden = !open;
      }

      function setExplore(open: boolean) {
        if (!exploreToggle || !exploreMenu) return;
        exploreToggle.setAttribute("aria-expanded", String(open));
        exploreToggle.classList.toggle("is-active", open);
        exploreMenu.hidden = !open;
      }

      navToggle?.addEventListener("click", () => {
        const open = navToggle.getAttribute("aria-expanded") === "true";
        setMobile(!open);
        setExplore(false);
      });

      exploreToggle?.addEventListener("click", () => {
        const open = exploreToggle.getAttribute("aria-expanded") === "true";
        setExplore(!open);
      });

      function onPointerDown(event: Event) {
        const target = event.target as Node | null;
        if (!target) return;
        if (wrapper && !wrapper.contains(target)) {
          setMobile(false);
          setExplore(false);
        }
      }

      document.addEventListener("mousedown", onPointerDown);
      document.addEventListener("touchstart", onPointerDown, { passive: true });

      window.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        setMobile(false);
        setExplore(false);
        // Escape should leave focus somewhere sensible rather than nowhere.
        if (exploreMenu && !exploreMenu.hidden) exploreToggle?.focus();
      });

      // Above the breakpoint the inline links are visible and CSS hides the
      // mobile menu; keep its state consistent so reopening below the
      // breakpoint behaves.
      const desktop = window.matchMedia("(min-width: 768px)");
      desktop.addEventListener("change", (e) => {
        if (e.matches) setMobile(false);
        else setExplore(false);
      });
    </script>
  </body>
</html>
